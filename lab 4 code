🔹 2. mcts.py (Core Logic)
import numpy as np
import random

class Node:
    def __init__(self, state, parent=None):
        self.state = state
        self.parent = parent
        self.children = []
        self.visits = 0
        self.reward = 0

def ucb(node):
    if node.visits == 0:
        return float('inf')
    return node.reward / node.visits + np.sqrt(2 * np.log(node.parent.visits) / node.visits)

def select(node):
    while node.children:
        node = max(node.children, key=ucb)
    return node

def expand(node, env):
    for action in range(env.action_space.n):
        child = Node(state=node.state, parent=node)
        node.children.append(child)
    return random.choice(node.children)

def simulate(env):
    state, _ = env.reset()
    total_reward = 0

    for _ in range(50):
        action = env.action_space.sample()
        state, reward, terminated, truncated, _ = env.step(action)
        total_reward += reward
        if terminated or truncated:
            break

    return total_reward

def backpropagate(node, reward):
    while node:
        node.visits += 1
        node.reward += reward
        node = node.parent

