import tensorflow as tf

class ActorCritic:
    def __init__(self, state_size, action_size):
        # Shared base
        inputs = tf.keras.layers.Input(shape=(state_size,))
        x = tf.keras.layers.Dense(128, activation='relu')(inputs)

        # Actor
        action_probs = tf.keras.layers.Dense(action_size, activation='softmax')(x)

        # Critic
        value = tf.keras.layers.Dense(1)(x)

        self.model = tf.keras.Model(inputs=inputs, outputs=[action_probs, value])
        self.optimizer = tf.keras.optimizers.Adam(learning_rate=0.001)


