    valid_y = np.ones((batch_size,1))

    g_loss = gan.train_on_batch(noise, valid_y)

    if epoch % 100 == 0:
        print(f"Epoch {epoch} | D Loss: {d_loss_real[0]} | G Loss: {g_loss}")

# Generate images
