from replay_buffer import ReplayBuffer

# Environment
env = gym.make("CartPole-v1")

state_size = int(env.observation_space.shape[0])
action_size = int(env.action_space.n)

# DQN
model = build_model(state_size, action_size)
buffer = ReplayBuffer()

# Hyperparameters
episodes = 50
batch_size = 32
gamma = 0.95
epsilon = 1.0
epsilon_decay = 0.995
epsilon_min = 0.01

for episode in range(episodes):
    state, _ = env.reset()
    total_reward = 0

    for time in range(200):
        # Epsilon-greedy
        if np.random.rand() < epsilon:
            action = env.action_space.sample()
        else:
            q_values = model.predict(np.array([state]), verbose=0)
            action = np.argmax(q_values[0])

        next_state, reward, terminated, truncated, _ = env.step(action)
        done = terminated or truncated

        buffer.store(state, action, reward, next_state, done)
        state = next_state
        total_reward += reward

        # Train
        if buffer.size() > batch_size:
            states, actions, rewards, next_states, dones = buffer.sample(batch_size)

            target = model.predict(states, verbose=0)
            target_next = model.predict(next_states, verbose=0)

            for i in range(batch_size):
                if dones[i]:
                    target[i][actions[i]] = rewards[i]
                else:
                    target[i][actions[i]] = rewards[i] + gamma * np.max(target_next[i])

            model.fit(states, target, epochs=1, verbose=0)

        if done:
            break

    # Decay epsilon
    if epsilon > epsilon_min:
        epsilon *= epsilon_decay

    print(f"Episode {episode+1}, Reward: {total_reward}")

env.close()

replay_buffer.py===
import random
import numpy as np
from collections import deque

class ReplayBuffer:
    def __init__(self, capacity=10000):
        self.buffer = deque(maxlen=capacity)

    def store(self, state, action, reward, next_state, done):
        self.buffer.append((state, action, reward, next_state, done))

    def sample(self, batch_size):
        batch = random.sample(self.buffer, batch_size)
        states, actions, rewards, next_states, dones = zip(*batch)
        return (
            np.array(states),
            np.array(actions),
            np.array(rewards),
            np.array(next_states),
            np.array(dones)
        )

    def size(self):
        return len(self.buffer)

