import gymnasium as gym
import numpy as np
import tensorflow as tf
from model import ActorCritic

env = gym.make("Acrobot-v1")

state_size = int(env.observation_space.shape[0])
action_size = int(env.action_space.n)

agent = ActorCritic(state_size, action_size)

gamma = 0.99
episodes = 50

for ep in range(episodes):
    state, _ = env.reset()
    total_reward = 0

    for t in range(500):
        state_tensor = tf.convert_to_tensor([state], dtype=tf.float32)

        probs, value = agent.model(state_tensor)
        probs = probs.numpy()[0]

        action = np.random.choice(action_size, p=probs)

        next_state, reward, terminated, truncated, _ = env.step(action)
        done = terminated or truncated

        next_state_tensor = tf.convert_to_tensor([next_state], dtype=tf.float32)
        _, next_value = agent.model(next_state_tensor)

        # Advantage
        target = reward + gamma * next_value * (1 - int(done))
        advantage = target - value

        # Train
        with tf.GradientTape() as tape:
            probs, value = agent.model(state_tensor)
            action_prob = probs[0, action]

            actor_loss = -tf.math.log(action_prob + 1e-10) * advantage
            critic_loss = tf.square(advantage)

            loss = actor_loss + critic_loss

        grads = tape.gradient(loss, agent.model.trainable_variables)
        agent.optimizer.apply_gradients(zip(grads, agent.model.trainable_variables))

        state = next_state
        total_reward += reward

        if done:
            break

    print(f"Episode {ep+1}, Reward: {total_reward}")

env.close()


